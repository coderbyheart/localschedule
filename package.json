{
  "name": "@coderbyheart/localschedule",
  "version": "0.0.0-development",
  "description": "Create a shareable schedule with times in your local timezone. Great for remote conferences!",
  "keywords": [
    "Conferences",
    "Schedule",
    "Timezones"
  ],
  "homepage": "https://github.com/coderbyheart/localschedule#readme",
  "bugs": {
    "url": "https://github.com/coderbyheart/localschedule/issues"
  },
  "license": "MIT",
  "author": "Markus Tacker | https://coderbyheart.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyheart/localschedule.git"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "node --test 'src/**/*.spec.ts' && vitest run",
    "test:e2e": "npx playwright test",
    "postinstall": "check-node-version --package",
    "lint": "oxlint"
  },
  "dependencies": {
    "@bifravst/from-env": "4.0.1",
    "@sentry/browser": "11.17.0",
    "@sentry/react": "11.17.0",
    "ajv": "8.20.0",
    "date-fns-tz": "3.2.0",
    "feather-icons": "4.29.2",
    "ics": "3.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@bifravst/object-to-env": "8.0.1",
    "@coderbyheart/oxlint-config": "1.0.1",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/feather-icons": "4.29.4",
    "@types/node": "26.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sinon": "22.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.4",
    "handlebars": "4.7.10",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "sinon": "22.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{md,json,yaml,yml,html}": [
      "oxfmt --write"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <13"
  }
}
